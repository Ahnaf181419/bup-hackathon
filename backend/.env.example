# Server
HOST=0.0.0.0
PORT=3001

# LLM (required for the judged interpretation path)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried when the primary model is rate-limited, slow or unavailable. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=9000
LLM_TOTAL_BUDGET_MS=15000

# Dashboard only (the judged endpoints never use these)
MONGO_URI=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
